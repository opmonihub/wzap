# Dev image: live-reload Go with Air + bind-mounted source. Prod Dockerfile
# stays untouched (multi-stage, distroless).
FROM golang:1.26

WORKDIR /src

RUN go install github.com/air-verse/air@v1.61.7 \
    && command -v bash && command -v flock

COPY go.mod go.sum ./
RUN go mod download

EXPOSE 8080

CMD ["bash", "./docker/dev-go.sh", "air", "-c", ".air.toml"]
